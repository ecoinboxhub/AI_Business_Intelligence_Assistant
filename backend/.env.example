# NexaSphere AI BI Backend — Environment Variables
# Copy to .env and fill in values.

# Gemini API key (required for AI narrative generation)
GEMINI_API_KEY=

# Server port (default: 5050)
PORT=5050

# AI model (default: gemini-2.5-flash)
AI_MODEL=gemini-2.5-flash

# CORS origins (comma-separated)
CORS_ORIGINS=https://ecoinboxhub.github.io,http://localhost:3030

# Dataset size (smaller = faster startup, less memory)
MOCK_DATASET_SIZE=500000
MOCK_DELIVERY_SIZE=100000
MOCK_DATASET_SEED=8
